#!/usr/bin/env bash
set -eu

case "${1:-}" in
export)
	shift

	debug=0
	if [ "${1:-}" = "--debug" ]; then
		debug=1
		shift
	fi

	tmp="$(mktemp)"
	trap 'rm -f "$tmp"' EXIT

	set +e
	if [ "$debug" = 1 ]; then
		printf '%s\n' '{"type":"debug","message":"debug output enabled"}' >&2
		opencode run "$@" --format json | tee "$tmp" >&2
		status=${PIPESTATUS[0]}
	else
		opencode run "$@" --format json >"$tmp"
		status=$?
	fi
	set -e

	if [ "$status" -ne 0 ]; then
		echo "opencodex: opencode run failed (exit code: $status)" >&2
		tail -n 1 "$tmp" | cut -c1-500 >&2
		exit "$status"
	fi

	sid="$(jq -r 'select(.type == "step_start" and .sessionID != null) | .sessionID' "$tmp" | head -n1)"
	[ -n "$sid" ] || {
		echo "opencodex: failed to get sessionID" >&2
		exit 1
	}
	opencode session export "$sid" >"$tmp" || {
		echo "opencodex: session export failed (sessionID: $sid)" >&2
		exit 1
	}
	cat "$tmp"
	;;
*) exec opencode "$@" ;;
esac
