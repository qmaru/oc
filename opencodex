#!/usr/bin/env bash
set -eu

case "${1:-}" in
export)
	shift

	debug=0
	if [ "${1:-}" = "--debug" ]; then
		debug=1
		shift
	fi

	tmp="$(mktemp)"
	trap 'rm -f "$tmp"' EXIT

	if [ "$debug" = 1 ]; then
		printf '%s\n' '{"type":"debug","message":"debug output enabled"}' >&2
	fi

	set +e
	opencode run "$@" --format json >"$tmp"
	status=$?
	set -e

	if [ "$debug" = 1 ]; then
		cat "$tmp" >&2
	fi

	sid="$(jq -r 'select(.type == "step_start" and .sessionID != null) | .sessionID' "$tmp" | head -n1)"
	[ -n "$sid" ] || {
		echo "opencodex: failed to get sessionID (exit code: $status)" >&2
		exit 1
	}
	opencode session export "$sid" >"$tmp"
	cat "$tmp"
	;;
*) exec opencode "$@" ;;
esac
